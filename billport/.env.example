# Local development values. In production (NODE_ENV=production) every value below is required
# and the demo defaults are not used. Production: do not set PORT on Render, it is provided.

# NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://localhost:27017/billport

# Shared HMAC secret, must match dealdesk/.env. Production: at least 32 random characters.
BILLPORT_SECRET=billport-shared-secret
DEALDESK_WEBHOOK_URL=http://localhost:4000/webhooks/billport

# Protects /admin/* (chaos controls, inspection). When set, requests need the header
#   X-Admin-Token: <ADMIN_TOKEN>
# Leave empty locally. Production: required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# ADMIN_TOKEN=
