# Local development values. In production (NODE_ENV=production) set every value in the hosting
# dashboard instead: the app refuses to start if a required value is missing or a secret is weak.

# NODE_ENV=production
# Production: do not set PORT on Render, it is provided.
PORT=4000
# Must include the database name (…/dealdesk), otherwise the driver uses "test".
MONGO_URI=mongodb://localhost:27017/dealdesk

# Signing key for login tokens. Production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Browser origins allowed to call the API: exact origin(s), comma separated, no path or trailing slash.
# Leave unset locally (the Vite dev proxy is used). Required in production.
# CORS_ORIGIN=https://dealdesk-ui.onrender.com

# BillPort integration. BILLPORT_SECRET must match billport/.env (production: 32+ random characters).
BILLPORT_URL=http://localhost:5000
BILLPORT_SECRET=billport-shared-secret
BILLPORT_TIMEOUT_MS=4000

# Invoice push worker
PUSH_MAX_ATTEMPTS=8
PUSH_BASE_DELAY_MS=2000
PUSH_MAX_DELAY_MS=60000
PUSH_POLL_INTERVAL_MS=1000

# Reconciliation: invoices stuck in a non-final state longer than N minutes
RECONCILE_STALE_MINUTES=1
RECONCILE_INTERVAL_MS=20000
